# Connection string for Neon / Supabase / local Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ronakwood?sslmode=require"

# Admin login (stays on the server, never sent to the browser)
ADMIN_PASSWORD="a-strong-password-here"
# Used to sign login cookies for both admin and customers. 32+ random characters.
JWT_SECRET="at-least-32-random-characters-go-here"

# Optional: photos are uploaded to Cloudinary. Leave empty to store photos in the database.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
